# QuickMart-IOMS environment configuration
# Configure these through Apache SetEnv, Windows environment variables, or PHP runtime configuration.
# Do not create or commit a real .env file in this project.

QUICKMART_DB_HOST=localhost
QUICKMART_DB_NAME=quickmart_db
QUICKMART_DB_USER=quickmart_app
QUICKMART_DB_PASSWORD=replace-with-a-local-secret

# Leave empty for same-origin deployment. Set one exact trusted origin only when required.
QUICKMART_ALLOWED_ORIGIN=

# Optional locally; recommended as a high-entropy secret in production so
# login rate-limit keys cannot be correlated offline.
QUICKMART_RATE_LIMIT_SECRET=
